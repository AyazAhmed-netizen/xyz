{
  "manifest_version": 3,
  "name": "Suno Direct Downloader",
  "version": "3.0",
  "description": "Auto-records Suno songs when they play, tracks history and stats.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://suno.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Suno Downloader"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}