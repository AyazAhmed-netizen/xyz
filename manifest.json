{
  "manifest_version": 3,
  "name": "Suno Advanced Downloader",
  "short_name": "Suno Downloader",
  "version": "2.3.0",
  "description": "Smart Suno.com song downloader with side panel, MP3 conversion, queue management, and real-time progress tracking",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Suno Advanced Downloader - click to open panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*",
        "https://*.suno.com/*"
      ],
      "js": [
        "src/content/bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "notifications",
    "offscreen",
    "sidePanel",
    "downloads.open"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*"
  ],
  "options_ui": {
    "page": "src/popup/index.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116"
}
