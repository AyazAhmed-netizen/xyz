{
  "manifest_version": 3,
  "name": "Suno Direct Downloader",
  "version": "2.0",
  "description": "Captures audio from Suno songs for download.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://suno.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Suno Downloader"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}